# Copy to .env (same folder as pyproject.toml). .env is gitignored; never commit it.
# src/session.py loads this file at import, so every recorder and the uploader see it.

# SFTP upload target on queenbee (BUas network or FortiClient VPN only)
PLAYSMART_SFTP_HOST=10.4.28.2
PLAYSMART_SFTP_PORT=2422
PLAYSMART_SFTP_USER=localhost
PLAYSMART_SFTP_PASSWORD=
# What happens to the session's files after the game (server/python_app/sftp_upload.py):
#   keep = upload and keep the local copy (default)   off = never upload   move = upload, then delete local
PLAYSMART_UPLOAD=keep
# give up connecting after this long (off the VPN: fails fast, files stay local)
# PLAYSMART_SFTP_TIMEOUT_S=10

# OBS Studio -> Tools -> WebSocket Server Settings -> Show Connect Info
PLAYSMART_OBS_PASSWORD=

# League install folder, only if not C:\Riot Games\League of Legends (lcu.py reads its lockfile)
# PLAYSMART_LEAGUE_DIR=D:\Riot Games\League of Legends
# PLAYSMART_OBS_HOST=127.0.0.1
# PLAYSMART_OBS_PORT=4455

# Which game this rig captures. league (default): the capture starts and stops on League's
# local API and records game state. Anything else (valorant, cs2): F7 starts, F12 stops,
# no game-state stream, everything else the same.
PLAYSMART_GAME=league

# Capture switches (see TESTING.md). Comments go on their OWN line: a '# ...' after a
# value becomes part of the value (PLAYSMART_SKIP=eda   # ring   would skip nothing).
# Recorders to neither start nor expect, comma-separated. Lab PCs: eda,emotion
# (ring unverified; emotion off by decision until the DPO answer).
PLAYSMART_SKIP=eda,emotion
# no post-game dialog asking the player about their deaths
# PLAYSMART_SELF_LABELS=0
# how long to wait for the client's post-game stats block
# PLAYSMART_EOG_WAIT_S=45
# overlay without webcam/OpenFace
# PLAYSMART_OPENFACE=0
# inline Whisper after the recording (needs the transcription group)
# PLAYSMART_TRANSCRIBE=1
# no video
# PLAYSMART_OBS=0
# PLAYSMART_DATA_DIR=data

# Riot Developer API key (Match-V5 timeline validation of replay positions). Dev keys expire daily.
RIOT_API_KEY=
