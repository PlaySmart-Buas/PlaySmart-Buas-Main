# Copy to .env (same folder as pyproject.toml). .env is gitignored; never commit it.
# src/session.py loads this file at import, so every recorder and the uploader see it.

# SFTP upload target on queenbee (BUas network or FortiClient VPN only)
PLAYSMART_SFTP_HOST=10.4.28.2
PLAYSMART_SFTP_PORT=2422
PLAYSMART_SFTP_USER=localhost
PLAYSMART_SFTP_PASSWORD=

# OBS Studio -> Tools -> WebSocket Server Settings -> Show Connect Info
PLAYSMART_OBS_PASSWORD=
# PLAYSMART_OBS_HOST=127.0.0.1
# PLAYSMART_OBS_PORT=4455

# Capture switches (see TESTING.md)
# PLAYSMART_SKIP=eda          # comma-separated recorders to neither start nor expect
# PLAYSMART_OPENFACE=0        # overlay without webcam/OpenFace
# PLAYSMART_TRANSCRIBE=1      # inline Whisper after the recording (needs the transcription group)
# PLAYSMART_OBS=0             # no video
# PLAYSMART_DATA_DIR=data
